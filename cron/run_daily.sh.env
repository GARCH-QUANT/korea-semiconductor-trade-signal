# =========================
# Korea semiconductor trade signal pipeline
# Runtime environment template
# =========================

# ---- Project paths ----
PROJECT_ROOT=.
DATA_DIR=./data
CONFIG_DIR=./config
OUTPUT_DIR=./output
LOG_DIR=./logs

# ---- Raw trade data ----
TRASS_RAW_GLOB=trass_raw_*.json
KCS_RAW_GLOB=kcs_raw_*.json
HS_CODES_FILE=./config/hs_codes.yaml

# ---- Database ----
DB_TYPE=sqlite
SQLITE_PATH=./data/trade_signals.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trade_signals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_SCHEMA=public

# ---- Signal logic ----
DEFAULT_PERIOD_TYPE=monthly
PRIMARY_SIGNAL_PRICE_FIELD=unit_price_by_qty
SECONDARY_SIGNAL_PRICE_FIELD=unit_price_by_weight
PRICE_UP_THRESHOLD=0.08
QTY_SOFT_DROP_THRESHOLD=-0.05
ENABLE_PRELIMINARY_DOWNGRADE=true
DROP_UNIT_CHANGED_SIGNALS=true
DROP_REBUCKETED_SIGNALS=true
HBM_SIGNAL_GROUP=HBM_PROXY
SSD_SIGNAL_GROUP=SSD

# ---- Event study ----
RETURNS_FILE=./data/sample_returns_multiwindow.csv
BENCHMARK_FILE=./data/sample_benchmark_returns.csv
MARKET_MAPPING_FILE=./data/market_mapping_template.csv
EVENT_WINDOWS=1,3,5,10,20
DEFAULT_BENCHMARK_MODE=excess_return
ALIGN_EVENT_TIME=false

# ---- Report / output ----
SIGNAL_MASTER_FILE=./data/processed/signal_master.csv
EVENT_DETAIL_FILE=./data/processed/event_study_detail.csv
EVENT_SUMMARY_FILE=./data/processed/event_study_summary.csv
REPORT_FILE=./data/processed/trade_signal_report.md
TG_PREVIEW_FILE=./data/processed/tg_message_preview.txt

# ---- Telegram ----
TG_ENABLED=false
TG_BOT_TOKEN=replace_me
TG_CHAT_ID=replace_me
TG_PARSE_MODE=Markdown
TG_DISABLE_WEB_PREVIEW=true
TG_MESSAGE_MAX_LEN=3500

# ---- Scheduling / ops ----
RUN_MODE=manual
RUN_EVERY_DAYS=10
TIMEZONE=Asia/Hong_Kong
FAIL_ON_MISSING_INPUT=false
WRITE_DEBUG_LOG=true
LOG_LEVEL=INFO

# ---- KCS / TRASS references (verified URLs) ----
# TRASS 桌面查询页（已实测，Playwright 可用）
TRASS_BASE_URL=https://www.bandtrass.or.kr/customs/total.do?command=CUS001View&viewCode=CUS00201
# KCS 官方主页
KCS_BASE_URL=https://customs.go.kr

# ---- Future extensions ----
FX_SOURCE=KCS
ENABLE_FX_ADJUSTMENT=false
ENABLE_EVENT_REGRESSION=false
ENABLE_DASHBOARD_EXPORT=false
